# nestjs-payment-kit environment configuration
# Copy this file to .env and adjust values for your environment.
# Do not commit real secrets.

# Provider selected by default when a payment request does not explicitly
# specify one. One of: mock | stripe | zarinpal
PAYMENT_KIT_DEFAULT_PROVIDER=mock

# Comma-separated list of providers that may be selected at runtime.
# The default provider must be included. Disabled providers cannot be resolved.
# Example: mock,stripe
PAYMENT_KIT_ENABLED_PROVIDERS=mock

# How long (in seconds) an idempotency key is remembered before it can be
# reused for a new, unrelated request.
PAYMENT_KIT_IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Stripe (adapter not implemented yet — enabling it will fail closed) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Iranian provider, e.g. Zarinpal (adapter not implemented yet) ---
# ZARINPAL_MERCHANT_ID=
